   "source": [
    "def create_gender_gap_analysis(df):\n",
    "    \"\"\"Analyze gender gaps in financial inclusion\"\"\"\n",
    "    \n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"👥 INSIGHT 3: GENDER GAP ANALYSIS\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    if 'gender' not in df.columns:\n",
    "        print(\"⚠️ No gender data available for analysis\")\n",
    "        return\n",
    "    \n",
    "    year_col = extract_year_from_data(df)\n",
    "    value_col = 'value_numeric' if 'value_numeric' in df.columns else 'value'\n",
    "    \n",
