    "## 2. Dataset Breakdown Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Dataset breakdown by key dimensions\n",
    "def analyze_dataset_breakdown(df):\n",
    "    \"\"\"Comprehensive breakdown analysis with error handling\"\"\"\n",
    "    \n",
    "    print(\"=\" * 60)\n",
    "    print(\"📊 DATASET BREAKDOWN ANALYSIS\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    # Record type breakdown\n",
    "    if 'record_type' in df.columns:\n",
    "        print(\"\\n🔍 Record Type Distribution:\")\n",
    "        record_counts = df['record_type'].value_counts()\n",
    "        for record_type, count in record_counts.items():\n",
    "            percentage = (count / len(df)) * 100\n",
    "            print(f\"   • {record_type}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    # Pillar breakdown\n",
    "    if 'pillar' in df.columns:\n",
    "        print(\"\\n🏛️ Pillar Distribution:\")\n",
    "        pillar_counts = df['pillar'].value_counts(dropna=False)\n",
    "        for pillar, count in pillar_counts.items():\n",
    "            percentage = (count / len(df)) * 100\n",
    "            print(f\"   • {pillar}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    # Source type breakdown\n",
    "    source_col = None\n",
    "    for col in ['source_type', 'sourcetype', 'source']:\n",
    "        if col in df.columns:\n",
    "            source_col = col\n",
    "            break\n",
    "    \n",
    "    if source_col:\n",
    "        print(f\"\\n📋 Source Type Distribution ({source_col}):\")\n",
    "        source_counts = df[source_col].value_counts(dropna=False)\n",
    "        for source, count in source_counts.items():\n",
    "            percentage = (count / len(df)) * 100\n",
    "            print(f\"   • {source}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    # Indicator breakdown\n",
    "    if 'indicator_code' in df.columns:\n",
    "        print(\"\\n📈 Top 10 Indicators:\")\n",
    "        indicator_counts = df['indicator_code'].value_counts().head(10)\n",
    "        for indicator, count in indicator_counts.items():\n",
    "            percentage = (count / len(df)) * 100\n",
    "            print(f\"   • {indicator}: {count:,} ({percentage:.1f}%)\")\n",
    "    \n",
    "    return {\n",
    "        'record_types': df['record_type'].value_counts().to_dict() if 'record_type' in df.columns else {},\n",
    "        'pillars': df['pillar'].value_counts().to_dict() if 'pillar' in df.columns else {},\n",
    "        'sources': df[source_col].value_counts().to_dict() if source_col else {}\n",
    "    }\n",
    "\n",
    "# Perform breakdown analysis\n",
    "if df_main is not None:\n",
    "    breakdown_results = analyze_dataset_breakdown(df_main)\n",
    "else:\n",
    "    print(\"❌ Cannot perform breakdown analysis - no data loaded\")"
   ]
