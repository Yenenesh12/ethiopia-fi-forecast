   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Data Loading and Initial Exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load data using our modular loader\n",
    "loader = DataLoader(\"../data\")\n",
    "\n",
    "# Try different file formats\n",
    "df_main = loader.load_main_dataset(\"ethiopia_fi_unified_data.xlsx\")\n",
    "if df_main is None:\n",
    "    df_main = loader.load_main_dataset(\"ethiopia_fi_unified_data.csv\")\n",
    "\n",
    "df_ref = loader.load_reference_codes(\"reference_codes.xlsx\")\n",
    "if df_ref is None:\n",
    "    df_ref = loader.load_reference_codes(\"reference_codes.csv\")\n",
    "\n",
    "if df_main is not None:\n",
    "    print(f\"✅ Main dataset loaded: {df_main.shape}\")\n",
    "    validation_results = loader.validate_dataset(df_main)\n",
    "    print(f\"📋 Validation: {validation_results['shape'][0]} records, {validation_results['shape'][1]} columns\")\n",
    "else:\n",
    "    print(\"❌ Failed to load main dataset\")\n",
    "\n",
    "if df_ref is not None:\n",
    "    print(f\"✅ Reference codes loaded: {df_ref.shape}\")\n",
    "else:\n",
    "    print(\"⚠️ Reference codes not available\")"
   ]
